# Copy this file to .env for local use. The copied .env is ignored by Git.
SONOMED_PROJECT_ROOT=/path/to/SonoMed-VLM
SONOINSTRUCT_ROOT=/path/to/SonoInstruct
SONOMED_OUTPUT_ROOT=/path/to/outputs
HF_HOME=/path/to/huggingface-cache

# Prefer `hf auth login`; if required, set HF_TOKEN only in your shell or a
# protected secret store. Never commit a real token.
HF_TOKEN=
